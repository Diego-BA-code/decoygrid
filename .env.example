# Copiar a .env y ajustar. Nunca commitear .env.
DECOYGRID_ADMIN_USER=admin
DECOYGRID_ADMIN_PASSWORD=cambia-esta-clave-ya
DECOYGRID_SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Salidas de alertas (vacias = deshabilitadas)
DECOYGRID_WEBHOOK_URL=
DECOYGRID_TELEGRAM_BOT_TOKEN=
DECOYGRID_TELEGRAM_CHAT_ID=

# Solo se alerta por encima de esta severidad (1..5)
DECOYGRID_ALERT_MIN_SEVERITY=3

# Retencion de datos en dias (borrado automatico)
DECOYGRID_RETENTION_DAYS=30
